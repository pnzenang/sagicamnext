// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                       String   @id @default(uuid())
  clerkId                  String   @unique
  sponsorCode              String   @unique
  sponsorFirstName         String
  sponsorLastAndMiddleName String
  sponsorPhoneNumber       String
  sponsorEmail             String
  createdAt                DateTime @default(now())
  updateAt                 DateTime @updatedAt
}

model Member {
  id                        String              @id @default(uuid())
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  dateOfBirth               String
  countryOfBirth            String
  memberMatriculationNumber String
  delegateRecommendation    String
  memberStatus              String
  nameOfBeneficiary         String
  sponsorCode               String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  manuallyVestedAt          DateTime?
  nameChangeRequests        NameChangeRequest[]
  memberTransferRequests    MemberTransferRequest[]

  @@unique([firstName, lastAndMiddleNames, dateOfBirth, delegateRecommendation])
  @@index([memberStatus, manuallyVestedAt])
}

model RemovedMember {
  id                        String    @id @default(uuid())
  originalMemberId          String?
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  dateOfBirth               String
  countryOfBirth            String
  memberMatriculationNumber String
  sponsorCode               String
  nameOfBeneficiary         String?
  delegateRecommendation    String?
  memberStatus              String?
  reasonForLeaving          String
  originalMemberCreatedAt   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([sponsorCode, memberStatus])
}

model DeceasedMember {
  id                        String                   @id @default(uuid())
  originalMemberId          String?
  clerkId                   String
  firstName                 String
  lastAndMiddleNames        String
  dateOfBirth               String?
  countryOfBirth            String
  memberMatriculationNumber String
  registrationDate          String
  nameOfBeneficiary         String
  sponsorCode               String
  delegateRecommendation    String?
  memberStatus              String?
  dateOfDeath               String
  placeOfDeath              String
  contributionStatus        String
  originalMemberCreatedAt   DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  contributionCalculation   ContributionCalculationDeath?
  documents                 DeceasedMemberDocument[]

  @@index([sponsorCode, memberStatus])
}

model ContributionCalculationDeath {
  id                        String         @id @default(uuid())
  deceasedMemberId          String         @unique
  memberMatriculationNumber String         @unique
  amountToContribute        Decimal        @db.Decimal(10, 2)
  createdBy                 String
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  deceasedMember            DeceasedMember @relation(fields: [deceasedMemberId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ContributionCalculationAdminFee {
  id        String   @id @default("current")
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeceasedMemberDocument {
  id                     String         @id @default(uuid())
  deceasedMemberId       String
  clerkId                String
  sponsorCode            String
  documentType           String
  fileName               String
  mimeType               String
  fileSize               Int
  fileData               Bytes?
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  cloudinaryDeliveryType String?
  cloudinaryFormat       String?
  cloudinaryVersion      Int?
  secureUrl              String?
  status                 String         @default("submitted")
  rejectionReason        String?
  deceasedMember         DeceasedMember @relation(fields: [deceasedMemberId], references: [id], onDelete: Cascade)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([deceasedMemberId, documentType])
  @@index([deceasedMemberId])
  @@index([sponsorCode])
  @@index([clerkId])
  @@index([status])
}

model NameChangeRequest {
  id                          String    @id @default(uuid())
  memberId                    String
  clerkId                     String
  sponsorCode                 String
  currentFirstName            String
  currentLastAndMiddleNames   String
  requestedFirstName          String
  requestedLastAndMiddleNames String
  reason                      String
  documentRequired            Boolean   @default(false)
  fileName                    String?
  mimeType                    String?
  fileSize                    Int?
  cloudinaryPublicId          String?
  cloudinaryResourceType      String?
  cloudinaryDeliveryType      String?
  cloudinaryFormat            String?
  cloudinaryVersion           Int?
  secureUrl                   String?
  status                      String    @default("submitted")
  rejectionReason             String?
  reviewedBy                  String?
  reviewedAt                  DateTime?
  member                      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([memberId])
  @@index([clerkId])
  @@index([sponsorCode])
  @@index([status])
  @@index([createdAt])
}

model MemberTransferRequest {
  id                        String   @id @default(uuid())
  memberId                  String
  initiatingClerkId         String
  initiatingSponsorCode     String
  receivingClerkId          String
  receivingSponsorCode      String
  currentFirstName          String
  currentLastAndMiddleNames String
  memberMatriculationNumber String
  status                    String   @default("receiving_sponsor_pending")
  rejectionReason           String?
  receivingReviewedBy       String?
  receivingReviewedAt       DateTime?
  adminReviewedBy           String?
  adminReviewedAt           DateTime?
  member                    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([memberId])
  @@index([initiatingClerkId])
  @@index([receivingClerkId])
  @@index([initiatingSponsorCode])
  @@index([receivingSponsorCode])
  @@index([status])
  @@index([createdAt])
}

model ContributionAssessment {
  id                    String                        @id @default(uuid())
  deathCount            Int                           @default(0)
  totalAmount           Decimal                       @db.Decimal(10, 2)
  totalVestedMembers    Int
  amountPerVestedMember Decimal                       @db.Decimal(10, 2)
  dueDate               DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  deaths                ContributionAssessmentDeath[]
  groups                ContributionAssessmentGroup[]
}

model ContributionAssessmentGroup {
  id                 String                 @id @default(uuid())
  assessmentId       String
  sponsorCode        String
  vestedMembersCount Int
  amountOwed         Decimal                @db.Decimal(10, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assessment         ContributionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, sponsorCode])
  @@index([sponsorCode])
}

model ContributionAssessmentDeath {
  id                        String                 @id @default(uuid())
  assessmentId              String
  memberMatriculationNumber String
  firstName                 String
  lastAndMiddleNames        String
  registrationDate          String
  dateOfDeath               String
  amountToContribute        Decimal                @db.Decimal(10, 2)
  sponsorCode               String
  createdAt                 DateTime               @default(now())
  assessment                ContributionAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([memberMatriculationNumber])
  @@index([sponsorCode])
}

model SponsorContributionPayment {
  id              String    @id @default(uuid())
  sponsorCode     String    @unique
  amountSent      Decimal   @db.Decimal(10, 2)
  amountVerified  Decimal   @default(0) @db.Decimal(10, 2)
  lastSubmittedAt DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sponsorCode])
  @@index([lastSubmittedAt])
}

model SponsorContributionUsage {
  id          String   @id @default(uuid())
  sponsorCode String   @unique
  amountUsed  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sponsorCode])
}

model SponsorRegistrationUsage {
  id                        String   @id @default(uuid())
  sponsorCode               String
  memberMatriculationNumber String   @unique
  amountUsed                Decimal  @default(40) @db.Decimal(10, 2)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([sponsorCode])
}

model SponsorContributionCredit {
  id                        String   @id @default(uuid())
  sponsorCode               String
  memberMatriculationNumber String   @unique
  amountCredited            Decimal  @default(30) @db.Decimal(10, 2)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([sponsorCode])
}

model SponsorBalanceAdjustment {
  id          String   @id @default(uuid())
  sponsorCode String
  balanceType String
  amount      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sponsorCode, balanceType])
  @@index([sponsorCode])
  @@index([balanceType])
}

model SponsorRegistrationPayment {
  id              String    @id @default(uuid())
  sponsorCode     String    @unique
  amountSent      Decimal   @db.Decimal(10, 2)
  amountVerified  Decimal   @default(0) @db.Decimal(10, 2)
  lastSubmittedAt DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sponsorCode])
  @@index([lastSubmittedAt])
}

model SponsorPaymentLedgerEntry {
  id          String   @id @default(uuid())
  sponsorCode String
  paymentType String
  eventType   String
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([sponsorCode])
  @@index([paymentType])
  @@index([eventType])
  @@index([createdAt])
}

model PaymentAlertReset {
  id          String   @id @default(uuid())
  alertType   String
  sponsorCode String   @default("__all__")
  resetAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([alertType, sponsorCode])
  @@index([sponsorCode])
}
